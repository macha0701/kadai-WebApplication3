doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      integrity="sha256-fx038NkLY4U1TCrBDiu5FWPEa9eiZu01EiLryshJbCo="
      crossorigin="anonymous")
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css")
    link(rel="stylesheet" href="style.css")
    title ToDo
  body.container.overflow-scroll(data-bs-theme="light")
    nav.navbar.fixed-top.bg-dark
      div.container-fluid
        h1.text-light.navbar-brand.mx-auto ToDo
          i.bi-check2-square.ms-1
    each post in posts
      - const cardClass = (user === post.postedBy ? 'card my-2 border-secondary' : 'card my-2')
      div(class=cardClass)
        div.card-body
          div.d-flex.justify-content-between
            h5.card-title(class=(post.done ? 'text-decoration-line-through text-muted' : '')) #{post.title || '（タイトルなし）'}
            - const tooltipTitle = `<small>${post.absoluteCreatedAt}</small>`
            small.card-text.float-end(data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" title=tooltipTitle) #{post.relativeCreatedAt}
          p.card-text.mb-2(class=(post.done ? 'text-decoration-line-through text-muted' : '')) #{post.content}
          form(method="post" action="/posts/toggle")
            input(type="hidden" name="id" value=post.id)
            input(type="hidden" name="oneTimeToken" value=oneTimeToken)
            button(type="submit").btn.btn-outline-success.btn-sm #{post.done ? '未完了に戻す' : '完了にする'}
        - const isDeletable = (user === post.postedBy || user === 'admin')
        if isDeletable
          div.card-footer.d-flex.justify-content-end
            form(method="post" action="/posts/delete")
              input(type="hidden" name="id" value=post.id)
              input(type="hidden" name="oneTimeToken" value=oneTimeToken)
              button(type="submit").btn.btn-outline-danger.btn-sm
                i.bi-trash
    div.fixed-bottom.p-4.bg-body
      form(method="post" action="/posts" name="message-form").container-fluid.row.g-3
        div.col-12
          input(type="text" name="title" maxlength="50" placeholder="タイトル").form-control
          textarea(name="content" rows="2" placeholder="やることを入力（Ctrl+Enterで追加）").form-control
          input(type="hidden" name="oneTimeToken" value=oneTimeToken)
        div.col-12
          button(type="submit").btn.btn-primary.float-end
            i.bi-send

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
      integrity="sha256-qlPVgvl+tZTCpcxYJFdHB/m6mDe84wRr+l81VoYPTgQ="
      crossorigin="anonymous")
    script(src="nn-chat.js")